---
// Reader feedback panel -- article-template layer only, display-only addition.
// No external requests; fires one GA4 event through the gtag already loaded in
// Layout.astro (silently no-ops if gtag is absent). Styled as a small
// instrument panel (charcoal edge strip + indicator lamp) to match the
// workbench design language. Does not touch any calculator JS.
---

<div class="cb-fb mt-10">
	<span class="cb-fb-lamp" data-cb-lamp aria-hidden="true"></span>
	<p class="cb-fb-label">Readout check</p>
	<p class="cb-fb-q">Did this tool do the job?</p>
	<div class="cb-fb-actions">
		<button type="button" class="cb-fb-key" data-cb-verdict="helpful">Yes, job done</button>
		<button type="button" class="cb-fb-key" data-cb-verdict="not_helpful">Not quite</button>
	</div>
	<p class="cb-fb-note" data-cb-note aria-live="polite"></p>
</div>

<script>
	const panel = document.querySelector('.cb-fb');
	if (panel) {
		const note = panel.querySelector('[data-cb-note]');
		const lamp = panel.querySelector('[data-cb-lamp]');
		const keys = Array.from(panel.querySelectorAll('button[data-cb-verdict]'));
		keys.forEach((key) => {
			key.addEventListener('click', () => {
				const verdict = key.getAttribute('data-cb-verdict');
				const w = window as typeof window & { gtag?: (...args: unknown[]) => void };
				if (w.gtag) w.gtag('event', 'page_feedback', { verdict });
				keys.forEach((k) => {
					(k as HTMLButtonElement).disabled = true;
				});
				key.classList.add('cb-fb-chosen');
				if (lamp) lamp.classList.add('cb-fb-lamp-on');
				if (!note) return;
				if (verdict === 'not_helpful') {
					const mailto =
						'mailto:contact@calcbadger.com?subject=' +
						encodeURIComponent('Page feedback: ' + location.pathname);
					note.innerHTML =
						'Logged, thanks. Tell us what’s missing: <a href="' +
						mailto +
						'">contact@calcbadger.com</a>';
				} else {
					note.textContent = 'Logged, thanks. Reading confirmed.';
				}
			});
		});
	}
</script>

<style>
	.cb-fb {
		position: relative;
		background: var(--card, #fff);
		border: 1px solid var(--rule);
		border-left: 5px solid var(--chassis);
		border-radius: 8px;
		padding: 1rem 1.1rem 1.1rem;
	}
	/* Indicator lamp: off until a key is pressed. Decorative only. */
	.cb-fb-lamp {
		position: absolute;
		top: 0.9rem;
		right: 0.85rem;
		width: 7px;
		height: 7px;
		border-radius: 999px;
		background: var(--rule);
		box-shadow: 0 0 0 2px rgb(161 161 170 / 0.18);
	}
	.cb-fb-lamp.cb-fb-lamp-on {
		background: var(--op);
		box-shadow: 0 0 0 2px rgb(234 88 12 / 0.18);
	}
	.cb-fb-label {
		margin: 0;
		font-family: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--ink);
		opacity: 0.55;
	}
	.cb-fb-q {
		margin: 0.5rem 0 0;
		font-size: 1rem;
		font-weight: 700;
		color: var(--ink);
	}
	.cb-fb-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 0.8rem;
	}
	/* Key caps on the chassis: dark plastic, pressable. */
	.cb-fb-key {
		cursor: pointer;
		font: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		background: var(--chassis);
		color: var(--chassis-text);
		border: 1px solid var(--chassis-rule);
		border-bottom-width: 3px;
		border-radius: 8px;
		padding: 0.5rem 1.05rem;
		min-height: 44px;
		transition:
			transform 160ms var(--ease-out-strong),
			border-color 160ms ease;
	}
	.cb-fb-key:active:not(:disabled) {
		transform: translateY(1px);
		border-bottom-width: 1px;
	}
	@media (hover: hover) and (pointer: fine) {
		.cb-fb-key:hover:not(:disabled) {
			border-color: var(--op);
		}
	}
	.cb-fb-key:focus-visible {
		outline: 2px solid var(--op-dark);
		outline-offset: 2px;
	}
	.cb-fb-key:disabled {
		cursor: default;
		background: var(--card, #fff);
		color: var(--ink);
		opacity: 0.55;
		border-color: var(--rule);
	}
	.cb-fb-key:disabled.cb-fb-chosen {
		opacity: 1;
		background: var(--chassis);
		color: var(--chassis-text);
		border-color: var(--chassis-rule);
		box-shadow: inset 0 -2px 0 var(--op);
	}
	.cb-fb-note {
		margin: 0.7rem 0 0;
		min-height: 2.6em;
		font-size: 0.85rem;
		line-height: 1.3;
		color: var(--ink);
		opacity: 0.75;
	}
	.cb-fb-note :global(a) {
		color: var(--op-dark);
		text-decoration: none;
	}
	.cb-fb-note :global(a:hover) {
		text-decoration: underline;
	}
</style>
