---
import { SITE_TITLE } from '../consts';
import { categorySlug, tools } from '../data/tools';
import BadgerLogo from './BadgerLogo.astro';

const categories = [...new Set(tools.map((t) => t.category))];
---

<!-- Light chrome: the page stays paper throughout, so the only dark object
     on any page is the calculator itself. The instrument owns the dark. -->
<header class="border-b border-[var(--rule)] bg-white">
	<nav class="mx-auto flex h-15 max-w-5xl items-center justify-between gap-2 px-4">
		<a href="/" class="flex shrink-0 items-center gap-2 no-underline" aria-label={`${SITE_TITLE} home`}>
			<BadgerLogo />
			<span class="font-display text-[1.25rem] font-bold tracking-tight text-[var(--ink)]"
				>Calc<span class="text-[var(--op)]">Badger</span></span
			>
		</a>

		<div class="hidden items-center gap-6 md:flex">
			<details id="categories-dropdown" class="relative">
				<summary
					class="flex cursor-pointer list-none items-center gap-1 text-[0.88rem] font-medium text-[var(--ink)]/65 no-underline transition-colors duration-150 hover:text-[var(--op-dark)] [&::-webkit-details-marker]:hidden"
				>
					Categories
					<svg width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</summary>
				<div class="absolute left-0 top-full z-10 mt-3 grid w-52 grid-cols-1 gap-0.5 rounded-lg border border-[var(--rule)] bg-white p-2 shadow-lg">
					{
						categories.map((cat) => (
							<a
								href={`/category/${categorySlug(cat)}/`}
								class="rounded-md px-3 py-2 text-[0.88rem] text-[var(--ink)]/70 no-underline transition-colors duration-150 hover:bg-[var(--rule)]/50 hover:text-[var(--op-dark)]"
							>
								{cat}
							</a>
						))
					}
				</div>
			</details>
			<a href="/about/" class="text-[0.88rem] font-medium text-[var(--ink)]/65 no-underline transition-colors duration-150 hover:text-[var(--op-dark)]">About</a>
		</div>

		<button
			id="menu-toggle"
			class="flex h-9 w-9 flex-col items-center justify-center gap-1.5 md:hidden"
			aria-label="Open menu"
			aria-expanded="false"
			aria-controls="mobile-menu"
		>
			<span class="h-px w-5 bg-[var(--ink)]"></span>
			<span class="h-px w-5 bg-[var(--ink)]"></span>
			<span class="h-px w-5 bg-[var(--ink)]"></span>
		</button>
	</nav>

	<div id="mobile-menu" class="hidden border-t border-[var(--rule)] bg-white md:hidden">
		<nav class="flex flex-col px-4 py-2">
			{
				categories.map((cat) => (
					<a
						href={`/category/${categorySlug(cat)}/`}
						class="border-b border-[var(--rule)] py-3 text-sm text-[var(--ink)]/80 no-underline"
					>
						{cat}
					</a>
				))
			}
			<a href="/about/" class="py-3 text-sm text-[var(--ink)]/80 no-underline">About</a>
		</nav>
	</div>
</header>

<script>
	const toggle = document.getElementById('menu-toggle')!;
	const menu = document.getElementById('mobile-menu')!;
	toggle.addEventListener('click', () => {
		const open = menu.classList.toggle('hidden');
		toggle.setAttribute('aria-expanded', String(!open));
	});

	const dropdown = document.getElementById('categories-dropdown') as HTMLDetailsElement;
	document.addEventListener('click', (e) => {
		if (dropdown.open && !dropdown.contains(e.target as Node)) {
			dropdown.open = false;
		}
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && dropdown.open) {
			dropdown.open = false;
		}
	});
</script>
