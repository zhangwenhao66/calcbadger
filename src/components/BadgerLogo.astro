---
/*
 * The mark: a badger looking out from behind an orange calculator, its ears
 * over the top edge and its face filling the display window. Chosen 2026-08-02
 * from a set of candidates; the keypad is a 3x2 grid because a denser grid
 * turns into an orange smear at nav (22px) and favicon (16px) sizes.
 *
 * Keep this in sync with public/favicon.svg, which carries the same artwork.
 * Pure inline SVG, so the header costs no extra request.
 */
interface Props {
	size?: number;
	/** Only needed if the logo is ever rendered twice on one page (clip-path id). */
	id?: string;
}
const { size = 26, id = 'cb-logo' } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
	<defs>
		<clipPath id={`${id}-screen`}>
			<rect x="6.9" y="9.4" width="18.2" height="8" rx="1.8"></rect>
		</clipPath>
	</defs>

	<!-- ears, above the calculator's top edge -->
	<circle cx="10.4" cy="6.1" r="3" fill="#18181b"></circle>
	<circle cx="21.6" cy="6.1" r="3" fill="#18181b"></circle>
	<circle cx="10.4" cy="6.4" r="1.3" fill="#f7f7f8"></circle>
	<circle cx="21.6" cy="6.4" r="1.3" fill="#f7f7f8"></circle>

	<!-- head, behind the body -->
	<path d="M8.2 10 C8.2 5.3 11.6 3.3 16 3.3 C20.4 3.3 23.8 5.3 23.8 10 Z" fill="#18181b"></path>

	<!-- calculator body -->
	<rect
		x="3.9"
		y="8.2"
		width="24.2"
		height="20.6"
		rx="3"
		fill="#ea580c"
		stroke="#18181b"
		stroke-width="1.7"></rect>

	<!-- display window -->
	<rect
		x="6.9"
		y="9.4"
		width="18.2"
		height="8"
		rx="1.8"
		fill="#f7f7f8"
		stroke="#18181b"
		stroke-width="1.4"></rect>

	<!-- the face, seen through the display -->
	<g clip-path={`url(#${id}-screen)`}>
		<path d="M8.6 9.0 H14.3 L13.5 17.6 H9.5 Z" fill="#18181b"></path>
		<path d="M23.4 9.0 H17.7 L18.5 17.6 H22.5 Z" fill="#18181b"></path>
		<circle cx="11.5" cy="12.7" r="1.5" fill="#f7f7f8"></circle>
		<circle cx="20.5" cy="12.7" r="1.5" fill="#f7f7f8"></circle>
		<circle cx="11.5" cy="12.9" r="0.62" fill="#18181b"></circle>
		<circle cx="20.5" cy="12.9" r="0.62" fill="#18181b"></circle>
		<ellipse cx="16" cy="15.7" rx="1.45" ry="1.05" fill="#18181b"></ellipse>
	</g>

	<!-- keypad: 3x2, gap 1.75, breathing room above and below -->
	<g fill="#ea580c" stroke="#18181b" stroke-width="1.25">
		<rect x="6.50" y="19.50" width="5.17" height="2.62" rx="0.84"></rect>
		<rect x="13.42" y="19.50" width="5.17" height="2.62" rx="0.84"></rect>
		<rect x="20.33" y="19.50" width="5.17" height="2.62" rx="0.84"></rect>
		<rect x="6.50" y="23.88" width="5.17" height="2.62" rx="0.84"></rect>
		<rect x="13.42" y="23.88" width="5.17" height="2.62" rx="0.84"></rect>
		<rect x="20.33" y="23.88" width="5.17" height="2.62" rx="0.84"></rect>
	</g>
</svg>
