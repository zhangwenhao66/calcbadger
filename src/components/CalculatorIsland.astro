{slug === 'time-duration-calculator' && <TimeDurationCalculator client:load />}
{slug === 'greek-alphabet' && <GreekAlphabetGenerator client:load />}
{slug === 'shape-volume-calculator' && <ShapeVolumeCalculator client:load />}
{slug === 'yes-or-no-wheel' && <YesNoWheel client:load />}
{slug === 'steps-to-miles-calculator' && <StepsToMilesCalculator client:load />}
