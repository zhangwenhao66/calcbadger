---
/**
 * Maps a tool slug to its Preact island. Used by both the full tool page and
 * the /embed/ skin so the two always render the identical component.
 * client:load — the calculator IS the page's primary content.
 */
import BmiCalculator from './calculators/BmiCalculator';
import BoardFootCalculator from './calculators/BoardFootCalculator';
import CalorieCalculator from './calculators/CalorieCalculator';
import CdCalculator from './calculators/CdCalculator';
import CoinFlipCalculator from './calculators/CoinFlipCalculator';
import ConcreteCalculator from './calculators/ConcreteCalculator';
import CursiveAlphabetGenerator from './calculators/CursiveAlphabetGenerator';
import DateCalculator from './calculators/DateCalculator';
import FractionCalculator from './calculators/FractionCalculator';
import GpaCalculator from './calculators/GpaCalculator';
import GreekAlphabetGenerator from './calculators/GreekAlphabetGenerator';
import LengthConverter from './calculators/LengthConverter';
import MathSymbolsGenerator from './calculators/MathSymbolsGenerator';
import MinecraftCircleGenerator from './calculators/MinecraftCircleGenerator';
import MolarityCalculator from './calculators/MolarityCalculator';
import MortgageCalculator from './calculators/MortgageCalculator';
import PercentageCalculator from './calculators/PercentageCalculator';
import ReactionTimeTest from './calculators/ReactionTimeTest';
import SatScoreCalculator from './calculators/SatScoreCalculator';
import ShapeVolumeCalculator from './calculators/ShapeVolumeCalculator';
import SquareFootageCalculator from './calculators/SquareFootageCalculator';
import StairCalculator from './calculators/StairCalculator';
import StepsToMilesCalculator from './calculators/StepsToMilesCalculator';
import TemperatureConverter from './calculators/TemperatureConverter';
import TimeConverter from './calculators/TimeConverter';
import TimeDurationCalculator from './calculators/TimeDurationCalculator';
import TipCalculator from './calculators/TipCalculator';
import VolumeConverter from './calculators/VolumeConverter';
import WeightConverter from './calculators/WeightConverter';
import WorldClockConverter from './calculators/WorldClockConverter';
import YesNoWheel from './calculators/YesNoWheel';

interface Props {
	slug: string;
}

const { slug } = Astro.props;
---

{slug === 'bmi-calculator' && <BmiCalculator client:load />}
{slug === 'board-foot-calculator' && <BoardFootCalculator client:load />}
{slug === 'calorie-calculator' && <CalorieCalculator client:load />}
{slug === 'cd-calculator' && <CdCalculator client:load />}
{slug === 'coin-flip-simulator' && <CoinFlipCalculator client:load />}
{slug === 'concrete-calculator' && <ConcreteCalculator client:load />}
{slug === 'date-calculator' && <DateCalculator client:load />}
{slug === 'square-footage-calculator' && <SquareFootageCalculator client:load />}
{slug === 'stair-calculator' && <StairCalculator client:load />}
{slug === 'sat-score-calculator' && <SatScoreCalculator client:load />}
{slug === 'molarity-calculator' && <MolarityCalculator client:load />}
{slug === 'mortgage-calculator' && <MortgageCalculator client:load />}
{slug === 'percentage-calculator' && <PercentageCalculator client:load />}
{slug === 'temperature-converter' && <TemperatureConverter client:load />}
{slug === 'length-converter' && <LengthConverter client:load />}
{slug === 'weight-converter' && <WeightConverter client:load />}
{slug === 'time-converter' && <TimeConverter client:load />}
{slug === 'volume-converter' && <VolumeConverter client:load />}
{slug === 'world-clock' && <WorldClockConverter client:load />}
{slug === 'tip-calculator' && <TipCalculator client:load />}
{slug === 'gpa-calculator' && <GpaCalculator client:load />}
{slug === 'reaction-time-test' && <ReactionTimeTest client:load />}
{slug === 'cursive-alphabet' && <CursiveAlphabetGenerator client:load />}
