---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION, ADSENSE_PUBLISHER_ID, GA4_ID, CLARITY_ID } from '../consts';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	ogType?: string;
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	ogImage = '/favicon.svg',
	ogType = 'website',
} = Astro.props;

const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#18181b" />
		{/* The ?v= is a cache buster: browsers hold favicons far longer than the
		    HTTP cache and will otherwise keep serving the old mark for days.
		    Bump it whenever the icon artwork changes. */}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" sizes="48x48 32x32 16x16" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
		<link rel="canonical" href={canonicalURL} />

		<meta name="google-adsense-account" content={ADSENSE_PUBLISHER_ID} />
		<script
			async
			src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-${ADSENSE_PUBLISHER_ID}`}
			crossorigin="anonymous"></script>

		<script
			async
			src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
		<script is:inline define:vars={{ GA4_ID }}>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', GA4_ID);
		</script>

		<script is:inline define:vars={{ CLARITY_ID }}>
			(function (c, l, a, r, i, t, y) {
				c[a] =
					c[a] ||
					function () {
						(c[a].q = c[a].q || []).push(arguments);
					};
				t = l.createElement(r);
				t.async = 1;
				t.src = 'https://www.clarity.ms/tag/' + i + '?ref=bwt';
				y = l.getElementsByTagName(r)[0];
				y.parentNode.insertBefore(t, y);
			})(window, document, 'clarity', 'script', CLARITY_ID);
		</script>

		<title>{pageTitle}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:url" content={canonicalURL} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />

		<slot name="head" />
	</head>
	<body class="flex min-h-screen flex-col">
		<Header />
		<main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8">
			<slot />
		</main>

		<div class="adsterra-slots">
			<script
				async="async"
				data-cfasync="false"
				src="https://pl31132702.profitableratecpmnetwork.com/c1ee7a8bb22cca73f06169bec1a89559/invoke.js"></script>
			<div id="container-c1ee7a8bb22cca73f06169bec1a89559"></div>

			<script is:inline>
				atOptions = {
					'key': '453f0c7d5e8119e586e5725c0308ea08',
					'format': 'iframe',
					'height': 250,
					'width': 300,
					'params': {},
				};
			</script>
			<script is:inline src="https://www.highrevenueformat.com/453f0c7d5e8119e586e5725c0308ea08/invoke.js"></script>

			<div class="adsterra-leaderboard">
				<script is:inline>
					atOptions = {
						'key': '61f1941686d5de03235e6be80021c844',
						'format': 'iframe',
						'height': 90,
						'width': 728,
						'params': {},
					};
				</script>
				<script is:inline src="https://www.highrevenueformat.com/61f1941686d5de03235e6be80021c844/invoke.js"></script>
			</div>
		</div>

		<style>
			.adsterra-slots {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1.5rem;
				max-width: 48rem;
				margin: 0 auto;
				padding: 1.5rem 1rem;
			}
			.adsterra-leaderboard {
				max-width: 100%;
				overflow-x: auto;
			}
		</style>

		<Footer />
	</body>
</html>
