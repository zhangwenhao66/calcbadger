---
import Layout from '../layouts/Layout.astro';
import WebSite from '../../vendor/site-toolkit/packages/schema/src/WebSite.astro';
import { categorySlug, tools } from '../data/tools';
import { SITE_DESCRIPTION, SITE_ORIGIN, SITE_TITLE } from '../consts';

const categories = [...new Set(tools.map((t) => t.category))];
---

<Layout>
	<WebSite slot="head" name={SITE_TITLE} url={`${SITE_ORIGIN}/`} description={SITE_DESCRIPTION} />

	{/* Nameplate strip instead of a hero: same words, instrument-plate form. */}
	<section class="nameplate mx-auto max-w-[960px]">
		<h1 class="font-display m-0 text-[1.15rem] font-bold tracking-tight text-[var(--ink)]">
			Calculators that show their work
		</h1>
		<p class="m-0 text-[0.9rem] leading-relaxed text-[var(--ink)]/70">
			Every CalcBadger tool explains its formula, cites the standard it follows, and runs entirely
			in your browser. Nothing you type leaves the page.
		</p>
	</section>

	{
		categories.map((cat) => (
			<section class="mx-auto mt-9 max-w-[960px]">
				<div class="mb-3 flex items-center justify-between gap-3">
					<h2 class="bench-label m-0">{cat}</h2>
					<a
						href={`/category/${categorySlug(cat)}/`}
						class="text-sm font-medium text-[var(--op-dark)] no-underline hover:underline"
					>
						All {cat.toLowerCase()} tools
					</a>
				</div>
				<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
					{tools
						.filter((t) => t.category === cat)
						.map((t) => (
							<a href={`/${t.slug}/`} class="bench-panel p-4 no-underline">
								<p class="font-display m-0 pr-6 text-[0.98rem] font-semibold text-[var(--ink)]">
									{t.title}
								</p>
								<p class="mt-1.5 mb-0 text-sm leading-relaxed text-[var(--ink)]/70">
									{t.description.length > 120 ? t.description.slice(0, 117) + '…' : t.description}
								</p>
							</a>
						))}
				</div>
			</section>
		))
	}
	<!-- LaunchSoar 免费收录徽章（2026-09-10，Owen 批准；验证只查首页，故放首页底部，不进全站布局） -->
	<p class="mt-10 mb-0 text-center">
		<a href="https://launchsoar.com" target="_blank" rel="noopener noreferrer" data-launch-badge="true" style="display:inline-flex;align-items:center;gap:10px;padding:10px 14px;border:1px solid #e5e7eb;border-radius:9999px;background:#ffffff;color:#111827;text-decoration:none;font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Helvetica Neue,Arial;line-height:1;"><img src="https://launchsoar.com/logo.png" alt="Launch" style="height:18px;width:auto;" loading="lazy" /><span style="display:flex;flex-direction:column;gap:2px;line-height:1.1;"><span style="font-size:12px;opacity:0.8;">Listed on</span><span style="font-size:14px;font-weight:700;">Launch</span></span></a>
	</p>
</Layout>
